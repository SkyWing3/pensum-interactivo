generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  resetToken   String?
  resetTokenExp DateTime?
  courses      UserCourse[]
}

model Course {
  id           String   @id
  name         String
  semester     Int
  prerequisites Json
  users        UserCourse[]
}

model UserCourse {
  id       Int    @id @default(autoincrement())
  user     User   @relation(fields: [userId], references: [id])
  userId   Int
  course   Course @relation(fields: [courseId], references: [id])
  courseId String
  status   String
  @@unique([userId, courseId])
}
